# Frontend (Vite) — safe for the browser bundle. Never put a service-role or
# provider key behind a VITE_ prefix; anything with this prefix ships to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase project (server-side / CLI use only — never in the frontend bundle)
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Messaging provider (server-side only — used by Edge Functions, never the browser)
PROVIDER_BASE_URL=https://dispatcher-production-72fc.up.railway.app
PROVIDER_API_KEY=

# scripts/probe-provider.ts guard rail (see docs/IMPLEMENTATION_PLAN.md §3.3)
# Leave unset outside of explicitly running the probe script.
PROBE_ALLOW_WRITE=false

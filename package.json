{
  "name": "campaign-portal",
  "private": true,
  "version": "0.0.0",
  "description": "Velocity Growth client campaign portal — take-home build",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "profile": "tsx scripts/profile-seed.ts",
    "db:push": "supabase db push",
    "db:query": "supabase db query --linked",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "sync:domain": "tsx scripts/sync-domain-to-edge-functions.ts",
    "functions:deploy": "npm run sync:domain && supabase functions deploy",
    "check:ac-coverage": "tsx scripts/check-ac-coverage.ts",
    "probe": "tsx scripts/probe-provider.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:watch": "vitest --project unit",
    "mutation": "tsx scripts/run-mutation.ts",
    "gate": "npm run typecheck && npm run lint && npm run depcruise && npm run test:coverage && npm run test:integration && npm run mutation"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^3.23.2",
    "prettier": "^3.3.3",
    "supabase": "^2.117.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}

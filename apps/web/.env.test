# Committed on purpose (unlike .env.local) — dummy, clearly-fake values so `vitest` (which Vite
# loads in "test" mode by default) can construct the Supabase client during component tests
# without needing real secrets. No test ever awaits a real network response from this URL; tests
# that need real request/response behaviour mock at the `supabase` client boundary instead.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsInRlc3QiOnRydWV9.not-a-real-key
